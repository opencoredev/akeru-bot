      "description": "Create transactions or other billing actions.",
      "approval": "pay"
    },
    {
      "id": "write-live-data",
      "description": "Create or update live Paddle billing data.",
      "approval": "production"
    },
    {
      "id": "delete-commerce-data",
      "description": "Delete Paddle resources when the API permits it.",
      "approval": "delete"
    },
    {
      "id": "manage-secrets",
      "description": "Create notification destinations or secret-backed settings.",
      "approval": "secrets"
    },
    {
      "id": "issue-refunds",
      "description": "Issue Paddle transaction refunds.",
      "approval": "refunds"
    },
    {
      "id": "manage-account",
      "description": "Change account-wide Paddle settings.",
      "approval": "account-wide"
    }
