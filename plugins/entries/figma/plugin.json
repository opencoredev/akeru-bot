  "license": "Proprietary",
  "logo": {
    "provenance": {
      "sourceUrl": "https://raw.githubusercontent.com/simple-icons/simple-icons/develop/icons/figma.svg",
      "license": "CC0-1.0"
    }
  },
  "platforms": ["web", "desktop", "mobile"],
