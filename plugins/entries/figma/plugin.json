  "capabilities": ["read design context", "create Figma content", "edit Figma content"],
  "publisher": {
    "name": "Figma",
    "url": "https://www.figma.com"
  },
  "maintainer": {
    "name": "Figma",
    "url": "https://www.figma.com"
  },
  "documentationUrl": "https://developers.figma.com/docs/figma-mcp-server/remote-server-installation/",
