    },
    {
      "id": "edit-designs",
      "description": "Create or update Figma and FigJam content.",
      "approval": "publishing"
    },
    {
      "id": "delete-designs",
      "description": "Delete Figma or FigJam content.",
      "approval": "delete"
    }
  ],
  "approvals": ["delete", "publishing"],
  "catalogStatus": "approval-pending"
