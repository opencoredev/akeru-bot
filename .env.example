# Optional public configuration for source builds.
# Copy into a repository-root `.env` or `.env.local`. Do not add server-side
# secrets to this file.

# Public, ingest-only mobile OpenTelemetry configuration. Not required for
# pairing a mobile client with an Akeru environment server.
# T3CODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# T3CODE_MOBILE_OTLP_TRACES_DATASET=akeru-mobile-traces-dev
# T3CODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
