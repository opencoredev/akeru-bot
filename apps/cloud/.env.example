# Copy to ~/.config/akeru-cloud/<stage>.env (staging.env, local.env). Every checkout
# on the machine reads it. An apps/cloud/.env overrides it, and the shell fills gaps.

# Required on every stage. Use the Clerk development instance for local and staging.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional. Without them, `slack.manager` OAuth answers `disabled`.
# SLACK_MANAGER_CLIENT_ID=
# SLACK_MANAGER_CLIENT_SECRET=

# Optional. Without a key, no analytics are sent.
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# Optional. Defaults to http://localhost:1337 on `local` and the workers.dev URL elsewhere.
# CLOUD_PUBLIC_URL=

# Optional. Set to 1 to pause hosted channels.
# KILL_SWITCH=
