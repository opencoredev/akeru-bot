exports[`mobile bot usage screen > matches the unavailable labelling snapshot 1`] = `"<div class="gap-3" accessibilityLabel="Bot usage"><div class="gap-2"><span class="px-2 text-sm font-t3-medium text-foreground-muted">Scout</span><div class="overflow-hidden rounded-[24px] border-continuous bg-card"><div class="gap-1 p-4"><span class="font-sans text-sm text-foreground-muted">Input</span><span class="font-sans text-lg text-foreground-muted">Unavailable</span></div><div class="gap-1 border-t border-border-subtle p-4"><span class="font-sans text-sm text-foreground-muted">Output</span><span class="font-sans text-lg text-foreground-muted">1,250+</span></div><div class="gap-1 border-t border-border-subtle p-4"><span class="font-sans text-sm text-foreground-muted">Observer</span><span class="font-sans text-lg tabular-nums text-foreground">0</span></div><div class="gap-1 border-t border-border-subtle p-4"><span class="font-sans text-sm text-foreground-muted">Reflector</span><span class="font-sans text-lg text-foreground-muted">Unavailable</span></div><div class="gap-1 border-t border-border-subtle p-4"><span class="font-sans text-sm text-foreground-muted">Cap</span><span class="font-sans text-lg tabular-nums text-foreground">12,345 / 20,000 tokens</span><span class="font-sans text-sm text-foreground-muted">Change the cap in a chat with this bot, under chat settings.</span></div><div class="gap-1 border-t border-border-subtle p-4"><span class="font-sans text-sm text-foreground-muted">Estimated cost</span><span class="font-sans text-lg text-foreground-muted">Unavailable</span><span class="font-sans text-sm text-foreground-muted">Estimated from model rates. Not subscription spend, and not an amount billed.</span></div><div class="gap-1 border-t border-border-subtle p-4"><span class="font-sans text-sm text-foreground-muted">Subscription pool</span><span class="font-sans text-lg text-foreground-muted">Unavailable</span></div><div class="gap-1 border-t border-border-subtle p-4"><