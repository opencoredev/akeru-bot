---
import BotAvatar from "../BotAvatar.astro";
import { HERO_BOTS } from "../../lib/heroBots";
import { DOWNLOAD_TARGETS, releaseAssetUrl, resolveBuildVersion } from "../../lib/releases";
import { docsUrl } from "../../lib/site";

// Direct release assets are baked at build time, so they never depend on the GitHub
// API. The shared client script picks the visitor's platform; until then the button
// opens /download.
const version = await resolveBuildVersion();

const downloadUrls = Object.fromEntries(
  DOWNLOAD_TARGETS.map((target) => [`data-url-${target.os}`, releaseAssetUrl(version, target.assetSuffix)]),
);
---
<section class="hero">
  <div class="hero-copy">
    <div class="hero-roster" aria-hidden="true">
      {
        HERO_BOTS.map((bot) => (
          <span class="hero-roster-bot" data-bot-hover>
            <BotAvatar name={bot.name} shape={bot.shape} color={bot.color} size={34} />
          </span>
        ))
      }
    </div>
    <h1 class="hero-title">An open-source Grok Bot alternative</h1>
    <p class="hero-sub">
      Akeru Bot gives each bot its own tools, instructions, and memory while keeping the
      application and environment under your control. Bring your existing Grok subscription,
      or connect Claude, Codex, Kimi, or OpenCode.
    </p>
    <div class="hero-actions">
      <a class="btn-primary" href="/download" data-download-auto {...downloadUrls}>
        <span data-download-label>Download</span>
      </a>
      <a class="btn-ghost" href={docsUrl("install")} target="_blank" rel="noopener noreferrer">
        <span>Read the docs</span>
      </a>
    </div>
    <p class="hero-note">Free and MIT licensed. No Akeru account required.</p>
  </div>

  <figure class="hero-shot">
    <img
      src="/app-screenshot.webp"
      srcset="/app-screenshot-1440.webp 1440w, /app-screenshot.webp 2880w"
      sizes="(max-width: 1320px) calc(100vw - 40px), 1280px"
      width="2880"
      height="1800"
      alt="Akeru Bot with five bots in the sidebar. Scout, a travel bot, answers which Lisbon flight has wifi."
      fetchpriority="high"
      decoding="async"
    />
  </figure>
</section>

<style>
  /* ── Hero ── */

  .hero-shot {
    width: 100%;
    max-width: 1280px;
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    overflow: hidden;
    background: var(--color-card);
    box-shadow: 0 40px 120px -40px rgb(0 0 0 / 0.8);
  }

  .hero-shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 64px;
    padding: 72px 64px 112px;
    overflow: clip;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    width: 100%;
  }

  .hero-roster {
    display: flex;
    gap: 10px;
    padding-bottom: 6px;
  }

  .hero-roster-bot {
    display: flex;
    padding: 4px;
  }

  .hero-title {
    max-width: 880px;
    font-size: 72px;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 76px;
    text-align: center;
    text-wrap: balance;
  }

  .hero-sub {
    max-width: 680px;
    font-size: 18px;
    line-height: 29px;
    text-align: center;
    color: var(--color-muted-foreground);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    padding-top: 6px;
  }

  .hero-note {
    font-size: 14px;
    line-height: 18px;
    color: var(--fg-dim);
  }

  /* ── Buttons ── */

  .btn-primary,
  .btn-ghost {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 13px 22px;
    border-radius: 999px;
    font-size: 15px;
    line-height: 18px;
  }

  .btn-primary {
    background: var(--color-primary);
    color: var(--color-primary-foreground);
    font-weight: 600;
    transition: background-color var(--duration-quick) ease;
  }

  .btn-primary:hover {
    background: var(--color-primary-hover);
  }

  .btn-ghost {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    font-weight: 500;
    transition: border-color var(--duration-quick) ease;
  }

  .btn-ghost:hover {
    border-color: var(--color-input);
  }

  @media (max-width: 900px) {
    .hero {
      padding: 40px 20px 72px;
      gap: 40px;
    }

    .hero-title {
      font-size: 44px;
      line-height: 48px;
    }

    .hero-sub {
      font-size: 16px;
      line-height: 26px;
    }
  }
</style>
