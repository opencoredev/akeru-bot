---
import { docsUrl } from "../../lib/site";
import { RELEASES_URL } from "../../lib/releases";
import { APPLE_MARK, WINDOWS_MARK, LINUX_MARK } from "./PlatformMarks";
---
  <section class="hero">
    <div class="hero-copy">
      <h1 class="hero-title">An open-source Grok Bot alternative</h1>
      <p class="hero-sub">
        Akeru Bot gives each bot its own tools, instructions, and memory while keeping the
        application and environment under your control. Bring your existing Grok subscription,
        or connect Claude, Codex, Kimi, or OpenCode.
      </p>
      <div class="hero-actions">
        <a id="download-btn" class="btn-primary" href={RELEASES_URL}>
          <svg class="os-mark" data-os="mac" width="17" height="17" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={APPLE_MARK} />
          <svg class="os-mark" data-os="win" width="17" height="17" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={WINDOWS_MARK} />
          <svg class="os-mark" data-os="linux" width="17" height="17" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={LINUX_MARK} />
          <span id="download-label">All downloads</span>
        </a>
        <a class="btn-ghost" href={docsUrl("install")} target="_blank" rel="noopener noreferrer">
          <svg width="17" height="17" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M15.5 7H8.5M12.499 11H8.499" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square"></path>
            <path d="M20 22H6C4.895 22 4 21.105 4 20M4 20C4 18.895 4.895 18 6 18H20V2H6C4.895 2 4 2.895 4 4V20Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square"></path>
          </svg>
          <span>Read the docs</span>
        </a>
      </div>
      <p class="hero-note">Free and MIT licensed. No Akeru account required.</p>
    </div>
    <div class="hero-shot">
      <img
        src="/app-screenshot.webp"
        width="1440"
        height="900"
        alt="The Akeru Bot desktop app with three bots working in one shared workspace"
        loading="eager"
        decoding="async"
      />
    </div>
  </section>
<style>


  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 44px;
    padding: 116px 64px 104px;
    overflow: clip;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
    width: 100%;
  }

  .hero-title {
    font-size: 84px;
    font-weight: 600;
    letter-spacing: -0.042em;
    line-height: 88px;
    text-align: center;
  }

  .hero-sub {
    max-width: 760px;
    font-size: 19px;
    line-height: 30px;
    text-align: center;
    color: var(--color-muted-foreground);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    padding-top: 4px;
  }

  .hero-note {
    font-size: 14px;
    line-height: 18px;
    color: var(--color-muted-foreground);
  }

  .hero-shot {
    width: 100%;
    aspect-ratio: 8 / 5;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-card);
    overflow: hidden;
  }

  .hero-shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .btn-primary, .btn-ghost {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 14px 22px;
    border-radius: var(--radius-md);
    font-size: 15px;
    line-height: 18px;
  }

  .btn-primary {
    background: var(--color-primary);
    color: var(--color-primary-foreground);
    font-weight: 600;
    transition: background-color 0.15s ease;
  }

  .btn-primary:hover {
    background: #2a5ad6;
  }

  .btn-ghost {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    font-weight: 500;
    transition: border-color 0.15s ease;
  }

  .btn-ghost:hover {
    border-color: var(--color-input);
  }
  .os-mark {
    display: none;
  }

  .btn-primary[data-os="mac"] .os-mark[data-os="mac"], .btn-primary[data-os="win"] .os-mark[data-os="win"], .btn-primary[data-os="linux"] .os-mark[data-os="linux"] {
    display: block;
  }

  @media (max-width: 900px) {
    .hero {
      padding: 64px 24px 72px;
      gap: 32px;
    }

    .hero-title {
      font-size: 46px;
      line-height: 50px;
    }

    .hero-sub {
      font-size: 16px;
      line-height: 26px;
    }

    .hero-shot {
      border-radius: 12px;
    }
  }

</style>
