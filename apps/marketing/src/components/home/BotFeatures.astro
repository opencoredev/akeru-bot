---
import { GithubIcon, GlobeIcon } from "@hugeicons/core-free-icons";
import BotAvatar from "../BotAvatar.astro";
import Icon from "../Icon.astro";
import { HERO_BOTS } from "../../lib/heroBots";

const [scout, relay] = HERO_BOTS;

const bots = [
  {
    title: "One tool list per bot",
    body: "Pick the plugins and MCP servers each bot can reach.",
  },
  {
    title: "Memory that outlives the conversation",
    body: "A bot carries what it learned into the next conversation.",
  },
  {
    title: "Its own instructions",
    body: "Write a profile for each bot. The bot follows it in every chat.",
  },
];

const features = [
  {
    title: "Helpers for big requests",
    body: "A bot can hand parts of a request to temporary helpers, up to three at once, and pull their results back together.",
  },
  {
    title: "Wherever you already talk",
    body: "Reach your bots from Slack, Discord, Telegram, iMessage, or WhatsApp.",
  },
  {
    title: "Voice calls",
    body: "Call a bot from the web or desktop app when typing is too slow.",
  },
  {
    title: "Sandboxes you pick",
    body: "Run work in a local workspace or in E2B, Daytona, Vercel Sandbox, Upstash Box, Tenki, Railway, or Ascii Box.",
  },
  {
    title: "Open it from any device",
    body: "Use a phone, tablet, browser, or second computer. Nothing proxies through a hosted Akeru service.",
  },
  {
    title: "Memory you can read",
    body: "Inspect, edit, or clear the notes a bot keeps about you and your work.",
  },
];

const GMAIL_LOGO = `<svg viewBox="52 42 88 66"><path fill="#4285f4" d="M58 108h14V74L52 59v43c0 3.32 2.69 6 6 6"/><path fill="#34a853" d="M120 108h14c3.32 0 6-2.69 6-6V59l-20 15"/><path fill="#fbbc04" d="M120 48v26l20-15v-8c0-7.42-8.47-11.65-14.4-7.2"/><path fill="#ea4335" d="M72 74V48l24 18 24-18v26L96 92"/><path fill="#c5221f" d="M52 51v8l20 15V48l-5.6-4.2c-5.94-4.45-14.4-.22-14.4 7.2"/></svg>`;

const tools = [
  { name: "Browser", detail: "Cloud browser", on: true, icon: GlobeIcon },
  { name: "GitHub", detail: "MCP server", on: true, icon: GithubIcon },
  { name: "Gmail", detail: "Composio", on: false, logo: GMAIL_LOGO },
];

const memories = ["Prefers aisle seats", "Sam leads design", "Ships on Thursdays", "Budget is €600"];
---
<section id="bots" class="bots">
  <h2 class="section-title">Every bot has its own setup</h2>
  <div class="setup-grid">
    {
      bots.map((bot, index) => (
        <article class="setup-card">
          <div class="setup-visual">
            {index === 0 && (
              <ul class="tool-list">
                {tools.map((tool) => (
                  <li class="tool-row">
                    {tool.icon ? (
                      <span class="tool-logo" aria-hidden="true"><Icon icon={tool.icon} size={18} /></span>
                    ) : (
                      <span class="tool-logo" aria-hidden="true" set:html={tool.logo} />
                    )}
                    <span class="tool-text">
                      <span class="tool-name">{tool.name}</span>
                      <span class="tool-detail">{tool.detail}</span>
                    </span>
                    <button type="button" class="toggle" role="switch" aria-checked={tool.on ? "true" : "false"} aria-label={`${tool.name} for ${scout.name}`} data-toggle>
                      <span class="toggle-thumb" />
                    </button>
                  </li>
                ))}
              </ul>
            )}
            {index === 1 && (
              <div class="memory">
                <div class="memory-head">
                  <BotAvatar name={scout.name} shape={scout.shape} color={scout.color} size={22} />
                  <span>{scout.name} remembers</span>
                </div>
                <ul class="memory-notes">
                  {memories.map((note) => <li>{note}</li>)}
                </ul>
              </div>
            )}
            {index === 2 && (
              <div class="profile">
                <div class="profile-head">
                  <BotAvatar name={relay.name} shape={relay.shape} color={relay.color} size={22} />
                  <span>{relay.name}'s instructions</span>
                </div>
                <p class="profile-body">
                  You maintain the checkout service. Run the tests before you call something fixed,
                  and keep pull requests small.
                </p>
              </div>
            )}
          </div>
          <div class="setup-copy">
            <h3>{bot.title}</h3>
            <p>{bot.body}</p>
          </div>
        </article>
      ))
    }
  </div>

  <ul class="features">
    {
      features.map((feature) => (
        <li class="feature">
          <h3>{feature.title}</h3>
          <p>{feature.body}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* ── Section shells ── */

  .section-title {
    font-size: 44px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 50px;
    text-align: center;
  }

  /* ── Bots ── */

  .bots {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 104px 64px;
  }

  .setup-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    width: 100%;
    margin-top: 52px;
  }

  /* Framed like the step cards: a bordered card with the visual on an inset panel. */
  .setup-card {
    display: flex;
    flex-direction: column;
    padding: 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
    background: var(--color-card);
  }

  .setup-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 212px;
    padding: 20px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-background);
  }

  .setup-copy {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 14px 14px;
  }

  .setup-copy h3 {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 24px;
  }

  .setup-copy p {
    font-size: 14px;
    line-height: 22px;
    color: var(--color-muted-foreground);
  }

  .tool-list {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 280px;
    list-style: none;
    border-radius: 14px;
    background: var(--color-card);
    box-shadow: var(--shadow-panel);
  }

  .tool-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 14px;
  }

  .tool-row + .tool-row {
    border-top: 1px solid var(--color-border);
  }

  .tool-logo {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: var(--color-secondary);
    box-shadow: inset 0 0 0 1px var(--color-border);
    color: var(--color-foreground);
  }

  .tool-logo :global(svg) {
    width: 18px;
    height: 18px;
  }

  .tool-text {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
  }

  .tool-name {
    font-size: 14px;
    font-weight: 600;
    line-height: 18px;
  }

  .tool-detail {
    font-size: 12px;
    line-height: 16px;
    color: var(--fg-dim);
  }

  .toggle {
    position: relative;
    flex-shrink: 0;
    width: 36px;
    height: 22px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--color-input);
    transition: background-color var(--duration-fast) var(--ease-smooth-out);
  }

  .toggle[aria-checked="true"] {
    background: var(--color-primary);
  }

  .toggle-thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.18);
    transition:
      transform var(--duration-fast) var(--ease-bounce),
      background-color var(--duration-fast) var(--ease-smooth-out);
  }

  .toggle[aria-checked="true"] .toggle-thumb {
    background: var(--color-background);
    transform: translateX(14px);
  }

  .toggle:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .memory,
  .profile {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    max-width: 280px;
  }

  .memory-head,
  .profile-head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    line-height: 18px;
  }

  .memory-notes {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
  }

  .memory-notes li {
    padding: 6px 11px;
    border-radius: 999px;
    background: var(--color-card);
    box-shadow: var(--shadow-panel);
    font-size: 13px;
    line-height: 17px;
  }

  .profile-body {
    padding: 14px 16px;
    border: 1px solid var(--color-input);
    border-radius: 12px;
    background: var(--color-card);
    font-size: 13px;
    line-height: 20px;
    color: var(--color-muted-foreground);
  }

  .features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px 48px;
    width: 100%;
    margin-top: 72px;
    list-style: none;
  }

  .feature {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .feature h3 {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 22px;
  }

  .feature p {
    font-size: 14px;
    line-height: 22px;
    color: var(--color-muted-foreground);
  }

  @media (max-width: 1100px) {
    .setup-grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 560px;
    }

    .features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .section-title {
      font-size: 32px;
      line-height: 38px;
    }

    .bots {
      padding: 64px 20px;
    }

    .features {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      margin-top: 48px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toggle,
    .toggle-thumb {
      transition: none;
    }
  }
</style>
