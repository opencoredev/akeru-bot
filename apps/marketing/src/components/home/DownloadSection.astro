---
import { RELEASES_URL } from "../../lib/releases";
import { APPLE_MARK, WINDOWS_MARK, LINUX_MARK } from "./PlatformMarks";


// `asset` is the release-asset suffix the client script resolves to a real URL.
const platforms = [
  { os: "mac", name: "macOS", detail: "Apple silicon · DMG", mark: APPLE_MARK, asset: "arm64.dmg" },
  { os: "win", name: "Windows", detail: "x64 · Installer", mark: WINDOWS_MARK, asset: "x64.exe" },
  { os: "linux", name: "Linux", detail: "x64 · AppImage", mark: LINUX_MARK, asset: "x64.AppImage", unsigned: true },
];


const DOWNLOAD_GLYPH = `<path d="M7 11.5L12 17.5L17 11.5H14L14 3H10L10 11.5H7Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
  <path d="M5 21H19" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />`;
---
  <section class="download">
    <div class="download-band">
      <div class="download-head">
        <h2>Download Akeru Bot</h2>
        <p>Free and MIT licensed. Bring your own subscription.</p>
      </div>
      <div class="platform-cards">
        {
          platforms.map((platform) => (
            <a class="platform-card" data-os={platform.os} data-asset={platform.asset} href={RELEASES_URL}>
              <span class="platform-card-top">
                <svg width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={platform.mark} />
                <svg class="platform-card-glyph" width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={DOWNLOAD_GLYPH} />
              </span>
              <span class="platform-card-text">
                <span class="platform-card-name">{platform.name}</span>
                <span class="platform-card-detail">{platform.detail}</span>
              </span>
            </a>
          ))
        }
      </div>
      <a class="btn-outline" href={RELEASES_URL} target="_blank" rel="noopener noreferrer">
        All downloads
      </a>
    </div>
  </section>
<style>


  .btn-outline {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 14px 22px;
    border-radius: var(--radius-md);
    font-size: 15px;
    line-height: 18px;
  }

  .btn-outline {
    border: 1px solid var(--color-border);
    font-weight: 500;
    transition: border-color 0.15s ease;
  }

  .btn-outline:hover {
    border-color: var(--color-input);
  }

  .download {
    display: flex;
    padding: 0 64px 104px;
  }

  .download-band {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 36px;
    width: 100%;
    padding: 64px 56px;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    background:
      linear-gradient(
        color-mix(in srgb, var(--color-background) 78%, transparent),
        color-mix(in srgb, var(--color-background) 78%, transparent)
      ),
      url("/download-glow.webp") center / cover no-repeat,
      var(--color-background);
  }

  .download-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }

  .download-head h2 {
    font-size: 36px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 42px;
  }

  .download-head p {
    font-size: 16px;
    line-height: 26px;
    color: color-mix(in srgb, var(--color-foreground) 72%, transparent);
  }

  .platform-cards {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .platform-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 264px;
    padding: 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-card) 80%, transparent);
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .platform-card:hover {
    border-color: var(--color-input);
    background: color-mix(in srgb, var(--color-popover) 92%, transparent);
  }

  .platform-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .platform-card-glyph {
    color: var(--color-muted-foreground);
  }

  .platform-card:hover .platform-card-glyph {
    color: var(--color-foreground);
  }

  .platform-card-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .platform-card-name {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 22px;
  }

  .platform-card-detail {
    font-size: 13px;
    line-height: 18px;
    color: var(--color-muted-foreground);
  }

  @media (max-width: 900px) {

    .download {
      padding: 0 24px 64px;
    }

    .download-band {
      padding: 40px 24px;
      gap: 28px;
    }

    .download-head h2 {
      font-size: 28px;
      line-height: 34px;
    }

    .platform-card {
      width: 100%;
    }
  }

</style>
