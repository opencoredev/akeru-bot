---
import BlogCover from "../../components/BlogCover.astro";
import Layout from "../../layouts/Layout.astro";
import { ARTICLES as articles } from "../../lib/articles";

const [featured, ...rest] = articles;

const siteOrigin = Astro.site ?? new URL(Astro.url.origin);

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Akeru Blog",
    description: "Guides and comparisons for running an open-source Grok Bot alternative.",
    url: new URL("/blog", siteOrigin).href,
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: articles.map((article, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: article.title,
      url: new URL(article.href, siteOrigin).href,
    })),
  },
];
---

<Layout
  title="Akeru Blog | Open-source AI bot guides"
  description="Read practical guides and factual comparisons for Akeru Bot, an open-source Grok Bot alternative you can self-host."
  structuredData={structuredData}
>
  <div class="blog-index">
    <header class="blog-header">
      <h1>Blog</h1>
      <p>Guides, comparisons, and updates from the Akeru project.</p>
    </header>

    <nav class="topic-nav" aria-label="Article topics">
      <a class="topic-link topic-link--active" href="#articles">All</a>
      {
        articles.map((article) => (
          <a class="topic-link" href={article.href}>{article.category}</a>
        ))
      }
    </nav>

    <section class="article-grid" id="articles" aria-label="All articles">
      {
        featured && (
          <a class="article-card article-card--featured" href={featured.href}>
            <BlogCover article={featured} size="feature" />
            <div class="article-body">
              <span class="article-category">{featured.category}</span>
              <h2>{featured.title}</h2>
              <p>{featured.summary}</p>
              <span class="article-meta">{featured.readMinutes} min read</span>
            </div>
          </a>
        )
      }
      {
        rest.map((article) => (
          <a class="article-card" href={article.href}>
            <BlogCover article={article} />
            <div class="article-body">
              <span class="article-category">{article.category}</span>
              <h2>{article.title}</h2>
              <p>{article.summary}</p>
              <span class="article-meta">{article.readMinutes} min read</span>
            </div>
          </a>
        ))
      }
    </section>
  </div>
</Layout>

<style>
  .blog-index {
    --color-editorial-muted-foreground: #b5b5b5;
    width: min(960px, calc(100% - 80px));
    margin: 0 auto;
    padding: 120px 0 140px;
  }

  .blog-header {
    display: grid;
    gap: 16px;
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .blog-header h1 {
    font-size: 60px;
    font-weight: 500;
    line-height: 66px;
    letter-spacing: -1.5px;
  }

  .blog-header p {
    color: var(--color-editorial-muted-foreground);
    font-size: 20px;
    font-weight: 500;
    line-height: 27px;
    letter-spacing: -0.2px;
  }

  .topic-nav {
    display: flex;
    gap: 40px;
    justify-content: center;
    margin-top: 72px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .topic-nav::-webkit-scrollbar { display: none; }

  .topic-link {
    flex: 0 0 auto;
    color: var(--color-dim-foreground);
    font-size: 14px;
    line-height: 19px;
    transition: color 0.15s ease;
  }

  .topic-link:hover,
  .topic-link:focus-visible,
  .topic-link--active {
    color: var(--color-foreground);
    font-weight: 500;
  }

  .topic-link:focus-visible,
  .article-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 56px 32px;
    margin-top: 48px;
    scroll-margin-top: 24px;
  }

  .article-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: 20px;
    min-width: 0;
  }

  .article-card--featured {
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: center;
    gap: 40px;
  }

  .article-card :global(.blog-cover) {
    transition: border-color 0.2s ease;
  }

  .article-card:hover :global(.blog-cover) {
    border-color: var(--color-input);
  }

  .article-body {
    display: grid;
    gap: 10px;
    min-width: 0;
  }

  .article-category {
    color: var(--color-muted-foreground);
    font-size: 13px;
    font-weight: 500;
    line-height: 18px;
  }

  .article-card h2 {
    font-size: 20px;
    font-weight: 500;
    line-height: 26px;
    letter-spacing: -0.3px;
  }

  .article-card--featured h2 {
    font-size: 32px;
    line-height: 38px;
    letter-spacing: -0.8px;
  }

  .article-card p {
    color: var(--color-editorial-muted-foreground);
    font-size: 15px;
    line-height: 23px;
  }

  .article-card--featured p {
    font-size: 17px;
    line-height: 26px;
  }

  .article-meta {
    color: var(--color-dim-foreground);
    font-size: 13px;
    line-height: 18px;
  }

  @media (max-width: 860px) {
    .blog-index { width: calc(100% - 40px); padding: 96px 0 104px; }
    .article-grid { gap: 48px 24px; }
    .article-card--featured { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .article-card--featured h2 { font-size: 26px; line-height: 32px; }
  }

  @media (max-width: 580px) {
    .blog-index { padding: 88px 0 96px; }
    .blog-header p { font-size: 18px; line-height: 25px; }
    .topic-nav { justify-content: flex-start; gap: 28px; margin-top: 48px; }
    .article-grid { grid-template-columns: 1fr; gap: 40px; margin-top: 32px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .topic-link,
    .article-card :global(.blog-cover) { transition: none; }
  }
</style>
