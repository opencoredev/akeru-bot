---
import LegalPage from "../components/LegalPage.astro";

const sections = [
  ["scope", "Scope"],
  ["reporting", "Reporting security issues"],
  ["responsibilities", "Shared responsibilities"],
  ["contact", "Contact"],
] as const;
---

<LegalPage
  title="Security Policy - Akeru Bot"
  description="How to report security issues in Akeru Bot."
  heading="Akeru Bot Security Policy"
  lede="This draft covers the Akeru Bot software and website. It does not cover agent providers or infrastructure that you operate."
  status="Draft - counsel review required"
  lastUpdated="2026-08-31"
  sections={sections}
>
  <section id="scope">
    <p class="section-number">01</p>
    <h2>Scope</h2>
    <p>
      This policy covers vulnerabilities in the Akeru Bot source code, packaged applications, and
      Akeru Bot website. It does not authorize testing third-party providers, user devices,
      repositories, networks, or environments.
    </p>
  </section>

  <section id="reporting">
    <p class="section-number">02</p>
    <h2>Reporting security issues</h2>
    <p>
      Use a private GitHub security advisory in the Akeru Bot repository. Include the affected
      version, impact, reproduction steps, and evidence with secrets removed. Do not publish the
      issue before maintainers have time to investigate it.
    </p>
  </section>

  <section id="responsibilities">
    <p class="section-number">03</p>
    <h2>Shared responsibilities</h2>
    <p>
      Akeru Bot runs coding agents on systems you control. Keep the app and operating system up to
      date. Protect provider and repository credentials. Review commands and source changes before
      you approve them. Revoke any credential that may have leaked.
    </p>
  </section>

  <section id="contact">
    <p class="section-number">04</p>
    <h2>Contact</h2>
    <p>
      Use the Akeru Bot repository for security questions. This draft must receive qualified legal
      counsel review before any public release.
    </p>
  </section>
</LegalPage>
