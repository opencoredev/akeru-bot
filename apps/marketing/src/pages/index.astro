---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/home/Hero.astro";
import BotFeatures from "../components/home/BotFeatures.astro";
import HowItWorks from "../components/home/HowItWorks.astro";
import DemoGallery from "../components/home/DemoGallery.astro";
import DownloadSection from "../components/home/DownloadSection.astro";
---

<Layout
  title="Akeru Bot | Open-source Grok Bot alternative"
  description="Run named Grok bots in an open-source desktop app you control. Akeru also connects to Claude, Codex, Kimi, and OpenCode with separate tools, plugins, instructions, and memory."
  socialTitle="Meet Akeru Bot"
>
  <!-- ── Hero ─────────────────────────────────────────────────── -->
  <Hero />

  <!-- ── Bots ─────────────────────────────────────────────────── -->
  <BotFeatures />

  <!-- ── How it works ─────────────────────────────────────────── -->
  <HowItWorks />

  <!-- ── Demos ────────────────────────────────────────────────── -->
  <DemoGallery />

  <!-- ── Download ─────────────────────────────────────────────── -->
  <DownloadSection />
</Layout>

<script>
  import { mountBotAvatars } from "../lib/botAvatarRuntime";
  import { initDemoVideos } from "../lib/homeDemoVideos";
  import { initStepDemos, initToolToggles } from "../lib/homeMotion";

  mountBotAvatars();

  initToolToggles();

  initStepDemos();

  initDemoVideos();
</script>
