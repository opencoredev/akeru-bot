---
import BotAvatar from "../components/BotAvatar.astro";
import Layout from "../layouts/Layout.astro";
import { HERO_BOTS } from "../lib/heroBots";
import { GithubIcon, GlobeIcon } from "@hugeicons/core-free-icons";
import Icon from "../components/Icon.astro";
import { DOWNLOAD_TARGETS, RELEASES_URL, releaseAssetUrl, resolveBuildVersion } from "../lib/releases";
import { docsUrl } from "../lib/site";

// Download links are baked to direct release assets at build time, so they never
// depend on the GitHub API. The shared client script swaps to the visitor's platform.
const version = await resolveBuildVersion();
const downloadUrls = Object.fromEntries(
  DOWNLOAD_TARGETS.map((target) => [`data-url-${target.os}`, releaseAssetUrl(version, target.assetSuffix)]),
);

const bots = [
  {
    title: "One tool list per bot",
    body: "Pick the plugins and MCP servers each bot can reach.",
  },
  {
    title: "Memory that outlives the conversation",
    body: "A bot carries what it learned into the next conversation.",
  },
  {
    title: "Its own instructions",
    body: "Write a profile for each bot. The bot follows it in every chat.",
  },
];

const steps = [
  {
    number: "1",
    title: "Connect a subscription",
    body: "Sign in with Claude, Codex, Grok, Kimi For Coding, or OpenCode. Akeru Bot adds no account of its own.",
  },
  {
    number: "2",
    title: "Create a bot",
    body: "Name it, pick a provider, and choose the tools it can reach.",
  },
  {
    number: "3",
    title: "Hand it work",
    body: "Chat from the desktop app, any browser on your network, or your phone. Bots keep working while you are away.",
  },
];

const features = [
  {
    title: "Helpers for big requests",
    body: "A bot can hand parts of a request to temporary helpers, up to three at once, and pull their results back together.",
  },
  {
    title: "Wherever you already talk",
    body: "Reach your bots from Slack, Discord, Telegram, iMessage, or WhatsApp.",
  },
  {
    title: "Voice calls",
    body: "Call a bot from the web or desktop app when typing is too slow.",
  },
  {
    title: "Sandboxes you pick",
    body: "Run work in a local workspace or in E2B, Daytona, Vercel Sandbox, Upstash Box, Tenki, Railway, or Ascii Box.",
  },
  {
    title: "Open it from any device",
    body: "Use a phone, tablet, browser, or second computer. Nothing proxies through a hosted Akeru service.",
  },
  {
    title: "Memory you can read",
    body: "Inspect, edit, or clear the notes a bot keeps about you and your work.",
  },
];

const demos = [
  {
    title: "Text your bot on iMessage",
    body: "Add Akeru to a group chat and your bot answers there like any other contact.",
    video: "https://egp0fj3aql.ufs.sh/f/oqH0Ibila2s0pjOXsCaF9MvsGzD4u1Sr2o8A07X3mnNBZOfE",
    poster: "/demo-imessage-poster.webp",
    label: "Akeru Bot responding in an iMessage conversation",
  },
  {
    title: "Hand off browser work",
    body: "A bot can manage a cloud browser and finish the work you hand off.",
    video: "https://egp0fj3aql.ufs.sh/f/oqH0Ibila2s0gmR7JKHqJZ0fozh9cC7SvGNsk42WyFE5TDeI",
    poster: "/demo-browser-poster.webp",
    label: "An Akeru Bot using a managed browser to finish bot work",
  },
  {
    title: "Talk instead of typing",
    body: "Start a voice call with your bot when you don't want to type.",
    video: "https://egp0fj3aql.ufs.sh/f/oqH0Ibila2s0NaYbDRPrp1SNGyXcrB2LHODWvh0g5fREJQIm",
    poster: "/demo-voice-poster.webp",
    label: "Starting a one-to-one voice call with an Akeru Bot",
  },
];

// `asset` is the release-asset suffix; the href is baked from the build-time version.
const platforms = [
  { os: "mac", name: "macOS", detail: "Apple silicon · DMG", asset: "arm64.dmg" },
  { os: "win", name: "Windows", detail: "x64 · Installer", asset: "x64.exe" },
  { os: "linux", name: "Linux", detail: "x64 · AppImage", asset: "x64.AppImage" },
].map((platform) => ({ ...platform, href: releaseAssetUrl(version, platform.asset) }));

const [scout, relay, mira] = HERO_BOTS as [
  (typeof HERO_BOTS)[number],
  (typeof HERO_BOTS)[number],
  (typeof HERO_BOTS)[number],
];

// BotActivityStatus from the app: the pixel comet circles this diamond while the
// label steps through the plain-language updates a working bot reports.
const GLYPH_CELLS = [
  [2, 0],
  [3, 1],
  [4, 2],
  [3, 3],
  [2, 4],
  [1, 3],
  [0, 2],
  [1, 1],
] as const;
const ACTIVITY_LABELS = [`${mira.name} is working`, "Reading a source", "Running checks", "Editing files"];

// The onboarding celebration, with the same burst math as OnboardingCelebration.tsx.
// A fixed seed keeps the build deterministic.
const CONFETTI_COLORS = [relay.color, relay.color, scout.color, "#FFA826", mira.color];
let seed = 7;
const random = () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};
const confetti = Array.from({ length: 16 }, (_, i) => {
  const r = random();
  const spread = (i / 15) * 2 - 1 + (random() - 0.5) * 0.2;
  return {
    x: Math.round(spread * 132),
    y: Math.round(-46 - r * 104),
    rotate: i % 2 === 0 ? 110 : -110,
    scale: (0.65 + random() * 0.5).toFixed(2),
    delay: Math.round(r * 0.12 * 0.66 * 1000),
    square: r > 0.45,
    color: CONFETTI_COLORS[i % CONFETTI_COLORS.length],
  };
});

const GMAIL_LOGO = `<svg viewBox="52 42 88 66"><path fill="#4285f4" d="M58 108h14V74L52 59v43c0 3.32 2.69 6 6 6"/><path fill="#34a853" d="M120 108h14c3.32 0 6-2.69 6-6V59l-20 15"/><path fill="#fbbc04" d="M120 48v26l20-15v-8c0-7.42-8.47-11.65-14.4-7.2"/><path fill="#ea4335" d="M72 74V48l24 18 24-18v26L96 92"/><path fill="#c5221f" d="M52 51v8l20 15V48l-5.6-4.2c-5.94-4.45-14.4-.22-14.4 7.2"/></svg>`;

const tools = [
  { name: "Browser", detail: "Cloud browser", on: true, icon: GlobeIcon },
  { name: "GitHub", detail: "MCP server", on: true, icon: GithubIcon },
  { name: "Gmail", detail: "Composio", on: false, logo: GMAIL_LOGO },
];

const memories = ["Prefers aisle seats", "Sam leads design", "Ships on Thursdays", "Budget is €600"];

const providers = ["Claude", "Codex", "Grok", "Kimi For Coding", "OpenCode"];
---

<Layout
  title="Akeru Bot | Open-source Grok Bot alternative"
  description="Run named Grok bots in an open-source desktop app you control. Akeru also connects to Claude, Codex, Kimi, and OpenCode with separate tools, plugins, instructions, and memory."
  socialTitle="Meet Akeru Bot"
>
  <!-- ── Hero ─────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-copy">
      <div class="hero-roster" aria-hidden="true">
        {
          HERO_BOTS.map((bot) => (
            <span class="hero-roster-bot" data-bot-hover>
              <BotAvatar name={bot.name} shape={bot.shape} color={bot.color} size={34} />
            </span>
          ))
        }
      </div>
      <h1 class="hero-title">An open-source Grok Bot alternative</h1>
      <p class="hero-sub">
        Akeru Bot gives each bot its own tools, instructions, and memory while keeping the
        application and environment under your control. Bring your existing Grok subscription,
        or connect Claude, Codex, Kimi, or OpenCode.
      </p>
      <div class="hero-actions">
        <a class="btn-primary" href={downloadUrls["data-url-mac"]} data-os="mac" data-download-auto {...downloadUrls}>
          <span data-download-label>Download for macOS</span>
        </a>
        <a class="btn-ghost" href={docsUrl("install")} target="_blank" rel="noopener noreferrer">
          <span>Read the docs</span>
        </a>
      </div>
      <p class="hero-note">Free and MIT licensed. No Akeru account required.</p>
    </div>

    <figure class="hero-shot">
      <img
        src="/app-screenshot.webp"
        srcset="/app-screenshot-1440.webp 1440w, /app-screenshot.webp 2880w"
        sizes="(max-width: 1320px) calc(100vw - 40px), 1280px"
        width="2880"
        height="1800"
        alt="Akeru Bot with five bots in the sidebar. Scout, a travel bot, answers which Lisbon flight has wifi."
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  </section>

  <!-- ── Bots ─────────────────────────────────────────────────── -->
  <section id="bots" class="bots">
    <h2 class="section-title">Every bot has its own setup</h2>
    <div class="setup-grid">
      {
        bots.map((bot, index) => (
          <article class="setup-card">
            <div class="setup-visual">
              {index === 0 && (
                <ul class="tool-list">
                  {tools.map((tool) => (
                    <li class="tool-row">
                      {tool.icon ? (
                        <span class="tool-logo" aria-hidden="true"><Icon icon={tool.icon} size={18} /></span>
                      ) : (
                        <span class="tool-logo" aria-hidden="true" set:html={tool.logo} />
                      )}
                      <span class="tool-text">
                        <span class="tool-name">{tool.name}</span>
                        <span class="tool-detail">{tool.detail}</span>
                      </span>
                      <button type="button" class="toggle" role="switch" aria-checked={tool.on ? "true" : "false"} aria-label={`${tool.name} for ${scout.name}`} data-toggle>
                        <span class="toggle-thumb" />
                      </button>
                    </li>
                  ))}
                </ul>
              )}
              {index === 1 && (
                <div class="memory">
                  <div class="memory-head">
                    <BotAvatar name={scout.name} shape={scout.shape} color={scout.color} size={22} />
                    <span>{scout.name} remembers</span>
                  </div>
                  <ul class="memory-notes">
                    {memories.map((note) => <li>{note}</li>)}
                  </ul>
                </div>
              )}
              {index === 2 && (
                <div class="profile">
                  <div class="profile-head">
                    <BotAvatar name={relay.name} shape={relay.shape} color={relay.color} size={22} />
                    <span>{relay.name}'s instructions</span>
                  </div>
                  <p class="profile-body">
                    You maintain the checkout service. Run the tests before you call something fixed,
                    and keep pull requests small.
                  </p>
                </div>
              )}
            </div>
            <div class="setup-copy">
              <h3>{bot.title}</h3>
              <p>{bot.body}</p>
            </div>
          </article>
        ))
      }
    </div>

    <ul class="features">
      {
        features.map((feature) => (
          <li class="feature">
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ── How it works ─────────────────────────────────────────── -->
  <section id="how-it-works" class="how">
    <h2 class="section-title">Up and running in three steps</h2>
    <p class="how-sub">
      Your environment owns the chats, bot profiles, and memory. Run the environment on your
      machine or connect it to a cloud sandbox that you control.
    </p>
    <p class="how-sub">
      Looking for an <a href="/open-source-grok-bot">open-source Grok Bot alternative</a>?
      See how Akeru works with your Grok subscription, or follow the{" "}
      <a href="/guides/self-hosted-grok-bot">self-hosted Grok bot setup guide</a>.
    </p>
    <ol class="steps" data-steps>
      {
        steps.map((step, index) => (
          <li class="step">
            <div class="step-visual">
              {index === 0 && (
                <ul class="provider-chips" aria-label="Supported providers">
                  {providers.map((provider) => <li>{provider}</li>)}
                </ul>
              )}
              {index === 1 && (
                <div class="create" data-create data-name={relay.name}>
                  <div class="celebration">
                    <span class="confetti" aria-hidden="true">
                      {confetti.map((piece) => (
                        <span
                          class:list={["confetti-piece", { "is-square": piece.square }]}
                          style={`--x:${piece.x}px;--y:${piece.y}px;--rotate:${piece.rotate}deg;--scale:${piece.scale};--delay:${piece.delay}ms;background:${piece.color}`}
                        />
                      ))}
                    </span>
                    <span class="create-slot" aria-hidden="true" />
                    <BotAvatar name={relay.name} shape={relay.shape} color={relay.color} size={56} />
                  </div>
                  <div class="create-field">
                    <span class="create-name" data-create-name>{relay.name}</span>
                    <span class="create-caret" aria-hidden="true" />
                  </div>
                  <span class="create-provider">Claude</span>
                </div>
              )}
              {index === 2 && (
                <div class="chat-demo" data-activity data-labels={JSON.stringify(ACTIVITY_LABELS)}>
                  <p class="chat-bubble">Can you look at the failing checkout test?</p>
                  <div class="activity-row">
                    <span class="activity-glyph">
                      <svg aria-hidden="true" class="bot-thinking-glyph" viewBox="0 0 14 14">
                        {GLYPH_CELLS.map(([x, y], index) => (
                          <rect fill="currentColor" height="2" width="2" x={x * 3} y={y * 3} style={`--cell:${index}`} />
                        ))}
                      </svg>
                    </span>
                    <span class="bot-shimmer-text" data-activity-label>
                      {ACTIVITY_LABELS[0]}...
                      <span aria-hidden="true" class="bot-shimmer-sheen">
                        <span class="bot-shimmer-sheen-text">{ACTIVITY_LABELS[0]}...</span>
                      </span>
                    </span>
                  </div>
                </div>
              )}
            </div>
            <span class="step-number" aria-hidden="true">{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ── Demos ────────────────────────────────────────────────── -->
  <section id="demos" class="demos">
    <h2 class="section-title">See it work</h2>
    {
      demos.map((demo) => (
        <div class="demo-row">
          <div class="demo-copy">
            <h3>{demo.title}</h3>
            <p>{demo.body}</p>
          </div>
          <div class="demo-media">
            <video
              data-demo-video
              data-src={demo.video}
              poster={demo.poster}
              aria-label={demo.label}
              muted
              loop
              playsinline
              preload="metadata"
            />
          </div>
        </div>
      ))
    }
  </section>

  <!-- ── Download ─────────────────────────────────────────────── -->
  <section class="download">
    <div class="download-band">
      <div class="download-roster" aria-hidden="true">
        {
          HERO_BOTS.map((bot) => (
            <span data-bot-hover>
              <BotAvatar name={bot.name} shape={bot.shape} color={bot.color} size={30} />
            </span>
          ))
        }
      </div>
      <div class="download-head">
        <h2>Download Akeru Bot</h2>
        <p>Free and MIT licensed. Bring your own subscription.</p>
      </div>
      <div class="platform-cards">
        {
          platforms.map((platform) => (
            <a class="platform-card" data-os={platform.os} data-asset={platform.asset} href={platform.href}>
              <span class="platform-card-text">
                <span class="platform-card-name">{platform.name}</span>
                <span class="platform-card-detail">{platform.detail}</span>
              </span>
            </a>
          ))
        }
      </div>
      <a class="download-notes" href={`${RELEASES_URL}/tag/v${version}`} target="_blank" rel="noopener noreferrer">
        Version {version} release notes
      </a>
    </div>
  </section>
</Layout>

<script>
  import { pickMostVisibleDemo } from "../lib/demoPlayback";

  function initDemoVideos() {
    const videos = Array.from(document.querySelectorAll<HTMLVideoElement>("video[data-demo-video]"));
    if (videos.length === 0) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const visibility = new Map<HTMLVideoElement, number>();
    const preloadVideos = () => {
      videos.forEach((video) => {
        if (video.src) return;
        const source = video.dataset.src;
        if (source) video.src = source;
      });
    };

    const updatePlayback = () => {
      if (document.hidden || reduceMotion) {
        videos.forEach((video) => video.pause());
        return;
      }

      const activeIndex = pickMostVisibleDemo(
        videos.map((video) => visibility.get(video) ?? 0),
      );

      videos.forEach((video, index) => {
        if (index === activeIndex) void video.play().catch(() => undefined);
        else video.pause();
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          visibility.set(video, entry.intersectionRatio);
        });
        updatePlayback();
      },
      { threshold: [0, 0.25, 0.5, 0.75, 1] },
    );

    videos.forEach((video) => observer.observe(video));
    document.addEventListener("visibilitychange", updatePlayback);
    if (document.readyState === "complete") preloadVideos();
    else window.addEventListener("load", preloadVideos, { once: true });
  }

  initDemoVideos();
</script>

<script>
  import { mountBotAvatar, mountBotAvatars } from "../lib/botAvatarRuntime";

  mountBotAvatars();

  document.querySelectorAll<HTMLButtonElement>("button[data-toggle]").forEach((toggle) => {
    toggle.addEventListener("click", () => {
      toggle.setAttribute("aria-checked", String(toggle.getAttribute("aria-checked") !== "true"));
    });
  });

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Runs `enter` each time an element scrolls into view and `leave` when it scrolls out,
  // so nothing animates off screen.
  const whileInView = (
    selector: string,
    enter: (element: HTMLElement) => void,
    leave: (element: HTMLElement) => void,
  ) => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const element = entry.target as HTMLElement;
          if (entry.isIntersecting) enter(element);
          else leave(element);
        });
      },
      { threshold: 0.6 },
    );
    document.querySelectorAll<HTMLElement>(selector).forEach((element) => observer.observe(element));
  };

  // "Create a bot": the name types in, the avatar pops into its slot with the onboarding
  // confetti, then the provider chip lands. It resets off screen and replays on return.
  const createTimers = new WeakMap<HTMLElement, number[]>();
  const resetCreate = (element: HTMLElement) => {
    createTimers.get(element)?.forEach((timer) => window.clearTimeout(timer));
    createTimers.set(element, []);
    element.dataset.stage = "empty";
    const name = element.querySelector<HTMLElement>("[data-create-name]");
    if (name) name.textContent = "";
  };
  const playCreate = (element: HTMLElement) => {
    resetCreate(element);
    const timers = createTimers.get(element) ?? [];
    const name = element.querySelector<HTMLElement>("[data-create-name]");
    const full = element.dataset.name ?? "";
    const at = (ms: number, step: () => void) => timers.push(window.setTimeout(step, ms));
    at(320, () => (element.dataset.stage = "typing"));
    [...full].forEach((_, i) => {
      at(420 + i * 95, () => {
        if (name) name.textContent = full.slice(0, i + 1);
      });
    });
    const typed = 420 + full.length * 95 + 260;
    at(typed, () => {
      element.dataset.stage = "created";
      const avatar = element.querySelector<HTMLElement>(".bot-avatar");
      if (avatar) mountBotAvatar(avatar)?.beat(900);
    });
    at(typed + 420, () => (element.dataset.stage = "done"));
  };

  // "Hand it work": BotActivityStatus steps through the updates a working bot reports.
  // The app remounts the label on each change, which restarts the sheen; this does too.
  const activityTimers = new WeakMap<HTMLElement, number>();
  const activityLabels = (element: HTMLElement): string[] => JSON.parse(element.dataset.labels ?? "[]");
  const setActivityLabel = (element: HTMLElement, text: string) => {
    const label = element.querySelector<HTMLElement>("[data-activity-label]");
    if (!label) return;
    label.replaceChildren(document.createTextNode(`${text}...`));
    const sheen = document.createElement("span");
    sheen.className = "bot-shimmer-sheen";
    sheen.setAttribute("aria-hidden", "true");
    const sheenText = document.createElement("span");
    sheenText.className = "bot-shimmer-sheen-text";
    sheenText.textContent = `${text}...`;
    sheen.append(sheenText);
    label.append(sheen);
  };

  if (!reducedMotion) {
    document.querySelectorAll<HTMLElement>("[data-create]").forEach(resetCreate);
    whileInView("[data-create]", playCreate, resetCreate);
    whileInView(
      "[data-activity]",
      (element) => {
        element.dataset.active = "true";
        const labels = activityLabels(element);
        let index = 0;
        activityTimers.set(
          element,
          window.setInterval(() => {
            index = (index + 1) % labels.length;
            setActivityLabel(element, labels[index] ?? "");
          }, 2600),
        );
      },
      (element) => {
        delete element.dataset.active;
        window.clearInterval(activityTimers.get(element));
        setActivityLabel(element, activityLabels(element)[0] ?? "");
      },
    );
  }
</script>

<style>
  /* ── Hero ── */

  .hero-shot {
    width: 100%;
    max-width: 1280px;
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    overflow: hidden;
    background: var(--color-card);
    box-shadow: 0 40px 120px -40px rgb(0 0 0 / 0.8);
  }

  .hero-shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 64px;
    padding: 72px 64px 112px;
    overflow: clip;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    width: 100%;
  }

  .hero-roster {
    display: flex;
    gap: 10px;
    padding-bottom: 6px;
  }

  .hero-roster-bot {
    display: flex;
    padding: 4px;
  }

  .hero-title {
    max-width: 880px;
    font-size: 72px;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 76px;
    text-align: center;
    text-wrap: balance;
  }

  .hero-sub {
    max-width: 680px;
    font-size: 18px;
    line-height: 29px;
    text-align: center;
    color: var(--color-muted-foreground);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    padding-top: 6px;
  }

  .hero-note {
    font-size: 14px;
    line-height: 18px;
    color: var(--fg-dim);
  }

  /* ── Buttons ── */

  .btn-primary,
  .btn-ghost {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 13px 22px;
    border-radius: 999px;
    font-size: 15px;
    line-height: 18px;
  }

  .btn-primary {
    background: var(--color-primary);
    color: var(--color-primary-foreground);
    font-weight: 600;
    transition: background-color var(--duration-quick) ease;
  }

  .btn-primary:hover {
    background: var(--color-primary-hover);
  }

  .btn-ghost {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    font-weight: 500;
    transition: border-color var(--duration-quick) ease;
  }

