---
import Layout from "../layouts/Layout.astro";
import { GITHUB_REPOSITORY_URL } from "../lib/site";
import { RELEASES_URL } from "../lib/releases";

const features = [
  {
    title: "Message them like teammates",
    body: "Give tasks in plain language. They take projects start to end and come back when your approval is needed.",
    icon: '<path d="M3 6.5C3 4.6 4.6 3 6.5 3H13.5C15.4 3 17 4.6 17 6.5V10.5C17 12.4 15.4 14 13.5 14H8L4.5 17V14H6.5C4.6 14 3 12.4 3 10.5V6.5Z" fill="none" stroke="#A5A099" stroke-width="1.4" stroke-linejoin="round" />',
  },
  {
    title: "Run many at once",
    body: "One on a project, one on outbound, one on systems. They work in parallel and keep going 24/7.",
    icon: '<circle cx="7" cy="7" r="3" fill="none" stroke="#A5A099" stroke-width="1.4" /><circle cx="14" cy="12" r="3" fill="none" stroke="#A5A099" stroke-width="1.4" /><path d="M4 16.5C4 14.8 5.3 13.5 7 13.5" fill="none" stroke="#A5A099" stroke-width="1.4" stroke-linecap="round" />',
  },
  {
    title: "They get smarter",
    body: "Show a workflow once and it becomes a routine. Teammates keep context and learn from each other.",
    icon: '<path d="M10 3V6M10 14V17M3 10H6M14 10H17M5.5 5.5L7.5 7.5M12.5 12.5L14.5 14.5M14.5 5.5L12.5 7.5M7.5 12.5L5.5 14.5" fill="none" stroke="#A5A099" stroke-width="1.4" stroke-linecap="round" />',
  },
];

const useCases = [
  "Triage product feedback",
  "Keep the CRM clean",
  "File expenses automatically",
  "Draft the weekly report",
  "Watch competitors for changes",
  "Screen and schedule candidates",
];

const freeFeatures = [
  "The whole app, every teammate",
  "Runs on subscriptions you already pay for",
  "Your data stays on your machine",
  "MIT licensed, fork it any time",
];
---

<Layout>
  <!-- ── Hero ──────────────────────────────────────────────────── -->
  <section class="hero">
    <img class="hero-stamps" src="/stamps.png" alt="" width="300" height="169" loading="eager" decoding="async" />
    <p class="hero-eyebrow">THE OPEN-SOURCE GROK BOT ALTERNATIVE</p>
    <h1 class="hero-title">Busywork,<br />handed off.</h1>
    <p class="hero-sub">Hand real work to AI teammates. It comes back finished.</p>
    <div class="cta-row">
      <a id="download-btn" class="btn-download" href={RELEASES_URL}>
        <span id="download-label">Download for macOS</span>
        <svg width="13" height="13" viewBox="0 0 13 13" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M6.5 1.5V9M6.5 9L3.5 6M6.5 9L9.5 6" fill="none" stroke="var(--color-primary-foreground)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M2 11.5H11" fill="none" stroke="var(--color-primary-foreground)" stroke-width="1.4" stroke-linecap="round" />
        </svg>
      </a>
      <a class="btn-other" href="/download">
        <span>Other systems</span>
        <svg width="13" height="13" viewBox="0 0 13 13" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M6.5 1.5V9M6.5 9L3.5 6M6.5 9L9.5 6" fill="none" stroke="var(--color-primary)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M2 11.5H11" fill="none" stroke="var(--color-primary)" stroke-width="1.4" stroke-linecap="round" />
        </svg>
      </a>
      <span class="cta-aside">Always free</span>
    </div>
  </section>

  <!-- ── Features ─────────────────────────────────────────────── -->
  <section id="features" class="sec">
    <h2 class="sec-title">What your teammates can do</h2>
    <div class="feature-cards">
      {
        features.map((feature) => (
          <div class="feature">
            <svg width="20" height="20" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={feature.icon} />
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ── Use cases ────────────────────────────────────────────── -->
  <section id="use-cases" class="sec">
    <h2 class="sec-title">See what Akeru can do</h2>
    <div class="use-case-grid">
      {
        useCases.map((useCase) => (
          <div class="use-case">
            <span class="use-case-label">{useCase}</span>
            <span class="use-case-arrow">→</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ── Pricing ──────────────────────────────────────────────── -->
  <section id="pricing" class="sec sec-pricing">
    <h2 class="sec-title">Free. Forever.</h2>
    <p class="pricing-sub">
      The app costs nothing and never will. Bring the subscriptions you already pay for.
    </p>
    <div class="pricing-cards">
      <div class="price-card">
        <div class="price-head">
          <span class="price-name">Akeru Bot</span>
          <div class="price-line">
            <span class="price-big">$0</span>
            <span class="price-small">forever</span>
          </div>
        </div>
        <ul class="price-features">
          {
            freeFeatures.map((feature) => (
              <li>
                <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 6.5L4.5 9L10 3.5" fill="none" stroke="var(--color-primary)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                {feature}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ── Final CTA ────────────────────────────────────────────── -->
  <section id="download" class="final-cta">
    <h2 class="final-title">Hand it off today.</h2>
    <div class="final-actions">
      <a id="cta-download-btn" class="btn-download btn-download--lg" href={RELEASES_URL}>
        <span id="cta-download-label">Download for macOS</span>
      </a>
      <a class="btn-ghost" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">Star on GitHub</a>
    </div>
    <p class="closing-quote">“We shape our tools, and thereafter our tools shape us.”</p>
    <p class="closing-author">Marshall McLuhan</p>
  </section>
</Layout>

<script>
  import { fetchLatestRelease, RELEASES_URL, type ReleaseAsset } from "../lib/releases";

  type Platform = { os: "mac" | "win" | "linux"; label: string };

  function detectPlatform(): Platform | null {
    const ua = navigator.userAgent;
    if (/Win/i.test(ua)) return { os: "win", label: "Download for Windows" };
    if (/Mac/i.test(ua)) return { os: "mac", label: "Download for macOS" };
    if (/Linux/i.test(ua)) return { os: "linux", label: "Download for Linux" };
    return null;
  }

  // Macs always get the arm64 build. Browsers cannot reliably tell Apple Silicon
  // from Intel (the UA lies, GPU strings lie), and a wrong guess hands an Apple
  // Silicon user a broken app. Intel users pick their build on /download.
  // Do NOT add arch detection back here.
  function pickAsset(assets: ReleaseAsset[], platform: Platform): string | null {
    if (platform.os === "win") {
      return assets.find((a) => a.name.endsWith("-x64.exe"))?.browser_download_url ?? null;
    }
    if (platform.os === "mac") {
      return assets.find((a) => a.name.endsWith("-arm64.dmg"))?.browser_download_url ?? null;
    }
    if (platform.os === "linux") {
      return assets.find((a) => a.name.endsWith(".AppImage"))?.browser_download_url ?? null;
    }
    return null;
  }

  async function init() {
    const btn = document.getElementById("download-btn") as HTMLAnchorElement | null;
    const label = document.getElementById("download-label");
    const ctaBtn = document.getElementById("cta-download-btn") as HTMLAnchorElement | null;
    const ctaLabel = document.getElementById("cta-download-label");

    const platform = detectPlatform();
    if (!platform) return;
    if (label) label.textContent = platform.label;
    if (ctaLabel) ctaLabel.textContent = platform.label;

    try {
      const release = await fetchLatestRelease();
      const url = pickAsset(release.assets ?? [], platform);
      if (url) {
        if (btn) btn.href = url;
        if (ctaBtn) ctaBtn.href = url;
      }
    } catch {
      if (btn) btn.href = RELEASES_URL;
      if (ctaBtn) ctaBtn.href = RELEASES_URL;
    }
  }

  init();
</script>

<style>
  /* ── Hero ── */

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-stamps {
    margin-top: 58px;
    width: 300px;
    height: 169px;
    object-fit: cover;
    mix-blend-mode: screen;
  }

  .hero-eyebrow {
    margin-top: 44px;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.12em;
    font-weight: 500;
    color: var(--color-muted-foreground);
  }

  .hero-title {
    margin-top: 18px;
    font-size: 62px;
    line-height: 64px;
    letter-spacing: 0.005em;
    font-weight: 500;
    color: var(--color-foreground);
  }

  .hero-sub {
    margin-top: 24px;
    font-size: 15px;
    line-height: 23px;
    max-width: 420px;
    color: var(--color-muted-foreground);
  }

  .cta-row {
    margin-top: 32px;
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* ── Buttons ── */

  .btn-download {
    display: flex;
    align-items: center;
    height: 44px;
    padding: 0 22px;
    border-radius: var(--radius-md);
    gap: 9px;
    background-color: var(--color-primary);
    box-shadow: #1e1a141f 0px 1px 2px;
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    color: var(--color-primary-foreground);
    transition: transform 0.18s ease, filter 0.18s ease;
  }

  .btn-download:hover {
    transform: translateY(-1px);
    filter: brightness(1.08);
  }

  .btn-download:active {
    transform: translateY(0);
  }

  .btn-download--lg {
    height: 46px;
    padding: 0 24px;
    font-size: 14.5px;
  }

  .btn-other {
    display: flex;
    align-items: center;
    height: 44px;
    padding: 0 22px;
    border-radius: var(--radius-md);
    gap: 9px;
    border: 1px solid var(--color-primary);
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    color: var(--color-primary);
    transition: background 0.18s ease;
  }

  .btn-other:hover {
    background: rgba(139, 111, 201, 0.1);
  }

  .btn-ghost {
    display: flex;
    align-items: center;
    height: 46px;
    padding: 0 24px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    font-size: 14.5px;
    line-height: 18px;
    font-weight: 500;
    color: var(--color-foreground);
    transition: border-color 0.18s ease;
  }

  .btn-ghost:hover {
    border-color: var(--color-primary);
  }

  .cta-aside {
    font-size: 13px;
    line-height: 16px;
    color: var(--color-muted-foreground);
  }

  /* ── Sections ── */

  .sec {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding: 96px 48px 0;
  }

  .sec-title {
    font-size: 38px;
    line-height: 44px;
    font-weight: 500;
    text-align: center;
    color: var(--color-foreground);
  }

  /* ── Features ── */

  .feature-cards {
    display: flex;
    margin-top: 44px;
    width: 1000px;
    max-width: 100%;
    gap: 64px;
  }

  .feature {
    display: flex;
    flex-direction: column;
    width: 33.33%;
    gap: 10px;
    padding: 0 26px;
  }

  .feature svg {
    flex-shrink: 0;
    margin-bottom: 6px;
  }

  .feature h3 {
    font-size: 15px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-foreground);
  }

  .feature p {
    font-size: 13.5px;
    line-height: 21px;
    color: var(--color-muted-foreground);
  }

  /* ── Use cases ── */

  .use-case-grid {
    display: flex;
    flex-wrap: wrap;
    margin-top: 40px;
    width: 900px;
    max-width: 100%;
    justify-content: center;
    gap: 14px;
  }

  .use-case {
    display: flex;
    align-items: center;
    height: 52px;
    padding: 0 22px;
    border-radius: 26px;
    gap: 10px;
    border: 1px solid var(--color-border);
  }

  .use-case-label {
    font-size: 14.5px;
    line-height: 18px;
    font-weight: 500;
    color: var(--color-foreground);
  }

  .use-case-arrow {
    font-size: 14.5px;
    line-height: 18px;
    color: var(--color-muted-foreground);
  }

  /* ── Pricing ── */

  .pricing-sub {
    margin-top: 14px;
    font-size: 15px;
    line-height: 23px;
    text-align: center;
    max-width: 460px;
    color: var(--color-muted-foreground);
  }

  .pricing-cards {
    display: flex;
    align-items: stretch;
    margin-top: 44px;
    width: 380px;
    max-width: 100%;
    gap: 20px;
  }

  .price-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 28px;
    border-radius: var(--radius-lg);
    background-color: var(--color-card);
    border: 1px solid var(--color-border);
    gap: 22px;
  }

  .price-head {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .price-name {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-foreground);
  }

  .price-line {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .price-big {
    font-size: 34px;
    line-height: 38px;
    font-weight: 500;
    color: var(--color-foreground);
  }

  .price-small {
    font-size: 13px;
    line-height: 16px;
    color: var(--color-muted-foreground);
  }

  .price-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .price-features li {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 13.5px;
    line-height: 18px;
    color: var(--color-muted-foreground);
  }

  .price-features svg {
    flex-shrink: 0;
  }

  /* ── Final CTA ── */

  .final-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding-top: 110px;
  }

  .final-title {
    font-size: 52px;
    line-height: 58px;
    font-weight: 500;
    text-align: center;
    color: var(--color-foreground);
  }

  .final-actions {
    margin-top: 30px;
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .closing-quote {
    margin-top: 100px;
    margin-bottom: 8px;
    font-size: 21px;
    line-height: 30px;
    text-align: center;
    max-width: 480px;
    font-weight: 500;
    color: var(--color-muted-foreground);
  }

  .closing-author {
    font-size: 12.5px;
    line-height: 16px;
    color: var(--color-muted-foreground);
  }

  /* ── Mobile ── */

  @media (max-width: 860px) {
    .hero-title {
      font-size: 44px;
      line-height: 48px;
    }

    .sec {
      padding: 64px 24px 0;
    }

    .feature-cards {
      flex-direction: column;
      width: 100%;
      gap: 32px;
    }

    .feature {
      width: 100%;
      padding: 0;
    }

    .pricing-cards {
      flex-direction: column;
    }

    .price-card {
      width: 100%;
    }

    .final-cta {
      padding-top: 72px;
    }

    .final-title {
      font-size: 38px;
      line-height: 44px;
    }
  }
</style>
