---
import { GITHUB_REPOSITORY_URL } from "../lib/site";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/site.css";
import PostHog from "../components/PostHog.astro";

interface Props {
  title?: string;
  description?: string;
  socialTitle?: string;
  socialType?: "website" | "article";
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  pageClass?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>[];
}

const {
  title = "Akeru Bot",
  description = "An open-source Grok Bot alternative that runs on your machine. Each bot keeps its own tools, instructions, and memory, with the provider subscription you choose.",
  socialTitle,
  socialType = "website",
  articlePublishedTime,
  articleModifiedTime,
  pageClass,
  noindex = false,
  structuredData: pageStructuredData = [],
} = Astro.props;

// Astro.site comes from astro.config.mjs. Falling back to the request URL keeps
// preview deployments and `astro dev` from emitting a broken absolute image URL.
const siteOrigin = Astro.site ?? new URL(Astro.url.origin);

const canonicalPath =
  Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/+$/, "");

const canonicalUrl = new URL(canonicalPath, siteOrigin);

const socialImageUrl = new URL("/og-v2.jpg", siteOrigin);

const socialImageAlt = "Meet Akeru Bot. Each bot keeps its own tools and its own memory.";

const softwareDescription =
  "Open-source desktop and web application for running named Grok bots with separate tools, plugins, instructions, and long-term memory.";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": `${siteOrigin.href}#akeru-bot`,
    name: "Akeru Bot",
    description: softwareDescription,
    url: siteOrigin.href,
    applicationCategory: "DeveloperApplication",
    operatingSystem: "macOS, Windows, Linux",
    isAccessibleForFree: true,
    author: {
      "@type": "Organization",
      name: "Akeru Bot maintainers",
      url: GITHUB_REPOSITORY_URL,
    },
    sameAs: [GITHUB_REPOSITORY_URL],
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
  },
  ...pageStructuredData,
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="canonical" href={canonicalUrl.href} />

    <meta property="og:type" content={socialType} />
    <meta property="og:site_name" content="Akeru Bot" />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:title" content={socialTitle ?? title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl.href} />
    {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle ?? title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl.href} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <link rel="preconnect" href="https://egp0fj3aql.ufs.sh" />
    <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
    <PostHog />
  </head>
  <body>
    <div class:list={["page", pageClass]}>
      <SiteHeader />

      <main class="main">
        <slot />
      </main>

      <SiteFooter />
    </div>
  </body>
</html>



<style>

  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    max-width: 1440px;
    margin: 0 auto;
    overflow-x: clip;
  }

  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

</style>
